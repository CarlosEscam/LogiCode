# Copie este archivo como .env y cambie los valores.
# Debe coincidir con POSTGRES_PASSWORD del .env de la raíz.
DATABASE_URL="postgresql://logicode:CAMBIAR_CONTRASENA@localhost:5433/logicode"
# Clave larga y aleatoria para firmar las sesiones (por ejemplo: openssl rand -hex 32)
JWT_SECRET="CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Dirección de la web para los enlaces de los correos (por defecto, CORS_ORIGIN)
APP_URL="http://localhost:3000"
# Carpeta de archivos subidos (por defecto backend/uploads)
# UPLOAD_DIR="uploads"
# Carpeta de las copias de seguridad diarias de la base (por defecto backend/copias)
# BACKUP_DIR="copias"

# IA para calificar fotos y respuestas abiertas: "ollama" (local) o "gemini" (API gratuita).
# Vacío: esas entregas quedan "en revisión" y las califica el docente.
AI_PROVIDER=""
# Ollama: instale https://ollama.com y descargue el modelo con "ollama pull qwen2.5vl:7b"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5vl:7b"
# Gemini: clave gratuita en https://aistudio.google.com/apikey
# GEMINI_MODEL vacío usa gemini-flash-latest, el alias que siempre apunta al Flash vigente.
GEMINI_API_KEY=""
GEMINI_MODEL=""
# Con menos confianza que esta (0 a 1), la nota queda en revisión
AI_MIN_CONFIDENCE="0.75"

# Primer administrador que crea "npm run db:seed"
SEED_ADMIN_CEDULA=""
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
